# Copy to `.env` if you want a local dotenv. Eval launchers read the
# environment, not this file: export the same names in your shell.

# Python interpreter of the eval venv (must see torch + transformers + this repo).
EVAL_PYTHON=python3

# GUI-Owl / UI-TARS checkpoints after `python scripts/download_omini_models.py`.
MODELS_DIR=models

# OmniParser v2 icon detector used by LIP (Module A). Required for paper runs.
# The code fails if this file is missing unless GEOPACT_ALLOW_FALLBACK_YOLO=1.
OMNIPARSER_ICON_WEIGHTS=models/omniparser/icon_detect/model.pt
MIU_YOLO_WEIGHTS=models/omniparser/icon_detect/model.pt

# Optional Hugging Face mirror.
# HF_ENDPOINT=https://huggingface.co
